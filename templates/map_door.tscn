[sub_resource type="GDScript" id="GDScript_utbtq"]
script/source = "extends Node3D

func bind(feature: WorldState.DoorFeature):
	feature.state_changed.connect(_on_state_changed)
	var initial_time: float = $Anim.get_animation(\"open\").length if feature.state == WorldState.DoorFeature.State.OPEN else 0.0
	$Anim.play(\"open\")
	$Anim.seek(initial_time, true, true)
	$Anim.pause()
	
func _on_state_changed(new_state: WorldState.DoorFeature.State) -> void:
	match new_state:
		WorldState.DoorFeature.State.OPEN:
			$Anim.play(\"open\")

		WorldState.DoorFeature.State.CLOSED, WorldState.DoorFeature.State.LOCKED:
			$Anim.play_backwards(\"open\")
"

